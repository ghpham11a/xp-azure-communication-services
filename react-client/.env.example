# Azure Communication Services Configuration
# Copy this file to .env and fill in your values

# Your ACS resource endpoint (found in Azure Portal > Your ACS Resource > Keys)
VITE_ACS_ENDPOINT=https://your-resource-name.communication.azure.com

# Backend endpoint for token generation (you need to create this)
VITE_TOKEN_ENDPOINT=http://localhost:7071/api/token

# Optional: Your ACS phone number for PSTN calls (format: +1234567890)
VITE_ACS_PHONE_NUMBER=
